PORT=7000

DLHD_BASE_URL=https://dlstreams.top
DLHD_ADDON_ID=com.dlhd.stremio
DLHD_ADDON_NAME=DLHD Streams
DLHD_ADDON_VERSION=0.1.3
DLHD_ADDON_DESCRIPTION=Scraped live channels and schedule grouped by country for Stremio.

DLHD_HTTP_TIMEOUT=20
DLHD_PROXY_MAX_REDIRECTS=5
# Optional additive allowlist. Leave unset to use built-in provider defaults.
# DLHD_PROXY_ALLOWED_HOSTS=extra.example.com,.extra.example.com
# DLHD_PROXY_ALLOWED_HOSTS_STRICT=0
DLHD_ARTWORK_ENABLED=1
DLHD_ARTWORK_CHANNELS_UPSTREAM=1
DLHD_ARTWORK_EVENTS_PROVIDER=thesportsdb
DLHD_THE_SPORTS_DB_API_KEY=3
# Optional additive allowlist. Leave unset to use built-in artwork defaults.
# DLHD_ARTWORK_ALLOWED_HOSTS=extra.example.com,.extra.example.com
# DLHD_ARTWORK_ALLOWED_HOSTS_STRICT=0
DLHD_ARTWORK_CACHE_TTL=21600
DLHD_ARTWORK_MISS_CACHE_TTL=1800
DLHD_ARTWORK_CACHE_MAX_ENTRIES=512
DLHD_ARTWORK_IMAGE_CACHE_TTL=21600
DLHD_ARTWORK_IMAGE_CACHE_MAX_ENTRIES=256
DLHD_HTTP_POOL_CONNECTIONS=32
DLHD_HTTP_POOL_MAXSIZE=64
DLHD_SAFE_HTTP_RETRY_TOTAL=2
DLHD_SAFE_HTTP_RETRY_BACKOFF_SECONDS=0.25
DLHD_PLAYWRIGHT_WAIT=6
DLHD_PLAYWRIGHT_TIMEOUT_MS=20000
DLHD_PLAYWRIGHT_MAX_CONCURRENCY=4
DLHD_PLAYWRIGHT_IGNORE_HTTPS_ERRORS=0
DLHD_PLAYWRIGHT_IGNORE_HTTPS_ERROR_HOSTS=
DLHD_PLAYWRIGHT_REUSE_BROWSER=1
DLHD_CHANNEL_STREAM_MAX_RESULTS=2
DLHD_CHANNEL_STREAM_MAX_ATTEMPTS=3

DLHD_LIVE_STREAM_MAX_WORKERS=4
DLHD_LIVE_STREAM_MAX_RESULTS=4
DLHD_LIVE_STREAM_MAX_ATTEMPTS=6
DLHD_LIVE_STREAM_BUDGET_SECONDS=30

DLHD_CHANNELS_CACHE_TTL=43200
DLHD_CHANNELS_CACHE_STALE_TTL=900
DLHD_CHANNELS_CACHE_MAX_ENTRIES=4
DLHD_CHANNEL_INDEX_CACHE_MAX_ENTRIES=4
DLHD_SCHEDULE_CACHE_TTL=120
DLHD_SCHEDULE_CACHE_STALE_TTL=120
DLHD_SCHEDULE_CACHE_MAX_ENTRIES=8
DLHD_SCHEDULE_INDEX_CACHE_MAX_ENTRIES=8
DLHD_SCHEDULE_DISPLAY_GMT_OFFSET_MINUTES=0
DLHD_EVENT_STALE_AFTER_MINUTES=360
DLHD_WATCH_CACHE_TTL=1800
DLHD_WATCH_CACHE_STALE_TTL=900
DLHD_WATCH_CACHE_MAX_ENTRIES=256
DLHD_STREAM_CACHE_TTL=120
DLHD_STREAM_CACHE_MAX_ENTRIES=512
DLHD_LIVE_CHANNEL_CACHE_TTL=120
DLHD_LIVE_CHANNEL_CACHE_MAX_ENTRIES=512
DLHD_HLS_PLAYLIST_CACHE_TTL=15
DLHD_HLS_PLAYLIST_CACHE_MAX_ENTRIES=256
DLHD_FAILED_STREAM_CACHE_TTL=30
